{
  "name": "OmniRAG RAG Query",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ask-omnirag",
        "responseMode": "responseNode"
      },
      "id": "trigger-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8081/api/webhooks/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Webhook-Secret", "value": "={{ $env.OMNIRAG_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "question", "value": "={{ $json.body.question }}" },
            { "name": "tenant_id", "value": "={{ $env.OMNIRAG_TENANT_ID }}" }
          ]
        }
      },
      "id": "omnirag-query-node",
      "name": "Query OmniRAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { answer: $json.answer, sources: $json.sources } }}"
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Query OmniRAG", "type": "main", "index": 0 }]]
    },
    "Query OmniRAG": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {}
}
