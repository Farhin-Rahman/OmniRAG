# Application Settings
APP_NAME=OmniRAG API
APP_ENV=development

# Database (SQLite)
DATABASE_URL=sqlite:///./data/omnirag.db

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=chunks
EMBEDDING_MODEL=sayed0am/arabic-english-bge-m3
EMBEDDING_DIM=1024

# File Storage
BLOB_STORAGE_DIR=data/blob_storage
DOCUMENTS_DIR=data/documents
BATCH_INPUT_DIR=data/batch-input
BATCH_TRACKING_FILE=data/batch-processed.json

CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://frontend:8000

# AI/LLM Configuration - Ollama (local, free, no API key)
# Install: https://ollama.com/download  |  Pull model: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=120
LLM_PROVIDER_PREFERENCE=ollama

# Webhook secret (for Make/n8n/Zapier integrations)
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=change-me-to-a-random-secret

# SharePoint Integration (optional — leave blank if not using SharePoint sync)
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=
SHAREPOINT_SITE_ID=

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000  # Override for local development
ML_SERVICE_TIMEOUT=10.0  # ML service timeout in seconds

# Retrieval Configuration
DENSE_K=50  # Number of candidates to retrieve
PER_DOC_LIMIT=3  # Max chunks per document
