# Application Settings
APP_NAME=OmniRAG API
APP_ENV=development

# Database (SQLite)
DATABASE_URL=sqlite:///./data/omnirag.db

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=chunks
EMBEDDING_MODEL=sayed0am/arabic-english-bge-m3
EMBEDDING_DIM=1024

# File Storage
BLOB_STORAGE_DIR=data/blob_storage
DOCUMENTS_DIR=data/documents
BATCH_INPUT_DIR=data/batch-input
BATCH_TRACKING_FILE=data/batch-processed.json

CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://frontend:8000

# AI/LLM Configuration - Ollama (local, free, no API key)
# Install: https://ollama.com/download  |  Pull model: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=120
LLM_PROVIDER_PREFERENCE=ollama

# Webhook secret (for Make/n8n/Zapier integrations)
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=change-me-to-a-random-secret

# Groq (optional — hosted, fast LLM inference; used instead of Ollama when
# set). Recommended for the voice agent: local CPU inference is far too
# slow for a live phone call (10+ seconds/response), Groq responds in ~1s.
# Free tier at console.groq.com, no card required.
GROQ_API_KEY=
# Default model — used by the voice agent and chat. A fast, direct-answer
# model (not a reasoning model) so token budgets aren't spent on hidden
# chain-of-thought.
GROQ_MODEL=allam-2-7b
# Trust & Safety moderation uses its own model — risk assessment benefits
# from reasoning and isn't latency-bound. Only takes effect when Groq is
# the active provider.
MODERATION_LLM_MODEL=openai/gpt-oss-20b

# Voice Agent (Retell AI Custom LLM integration — optional)
# WebSocket endpoint for Retell to connect to: /api/voice/llm-websocket/{call_id}
# Generate with: openssl rand -hex 32 (hex, not base64 — this value goes in a
# URL query param, and base64's "+" gets silently decoded as a space there)
VOICE_WEBSOCKET_SECRET=
N8N_BOOKING_WEBHOOK_URL=

# Slack alerts for campaign moderation hard-blocks/escalations (optional).
# Create a Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:8000  # Override for local development
ML_SERVICE_TIMEOUT=10.0  # ML service timeout in seconds

# Retrieval Configuration
DENSE_K=50  # Number of candidates to retrieve
PER_DOC_LIMIT=3  # Max chunks per document
