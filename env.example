# ========================================
# OMNIRAG - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=OmniRAG API
APP_ENV=development

# PostgreSQL Database
POSTGRES_USER=omnirag
POSTGRES_PASSWORD=omnirag_password
POSTGRES_DB=omnirag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neo4j (not required for current flows but kept for compatibility)
NEO_USER=neo4j
NEO_PASSWORD=neo-password
NEO_DB=neo4j
NEO_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/neo-password

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URI=http://${QDRANT_HOST}:${QDRANT_PORT}

# RabbitMQ (Celery broker + events)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Embeddings / ML Service
ML_SERVICE_URL=http://localhost:8000
EMBEDDING_MODEL=sayed0am/arabic-english-bge-m3
EMBEDDING_DIM=1024

# Storage
DOCUMENTS_DIR=data/documents
BLOB_STORAGE_DIR=data/blob_storage

# Feature flags
RERANK_ENABLED=true

# Docling / model cache (optional)
# Leave unset to allow online downloads into the shared cache volume.
# Set HF_HUB_OFFLINE=1 after pre-downloading models into DOCLING_CACHE_DIR/DOCLING_ARTIFACTS_PATH
HF_HUB_OFFLINE=
DOCLING_ARTIFACTS_PATH=

# Auth / LLM keys (optional; fill as needed)
OPENROUTER_API_KEY=
LLM_API_KEY=
JWT_SECRET_KEY=your_jwt_secret_here
DOWNLOAD_URL_SECRET=your_download_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
